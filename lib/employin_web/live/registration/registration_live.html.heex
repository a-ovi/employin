<.auth_card title="Complete Your Profile" subtitle="One last step before you get started">
  <.form
    id="registration-form"
    for={@form}
    action={~p"/login/with_token"}
    method="post"
    phx-change="validate"
    phx-submit="submit"
    phx-trigger-action={@trigger_submit}
    class="space-y-6"
  >
    <input type="hidden" name="token" value={@token} />
    <div>
      <.input
        type="text"
        field={@form[:display_name]}
        label="Display name"
        placeholder="Enter your display name"
        autocomplete="name"
        phx-debounce="500"
        required
      />
      <p class="mt-1.5 text-xs text-gray-500">
        This is how others will see you on the platform. Signing up as {@email}.
      </p>
    </div>

    <.submit_button loading_label="Processing...">Complete registration</.submit_button>
  </.form>
</.auth_card>
