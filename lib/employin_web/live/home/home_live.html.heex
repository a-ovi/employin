<div class="flex h-dvh flex-col overflow-hidden">
  <Layouts.app_header current_user={@current_user} active={:activity} />

  <main class="mx-auto flex min-h-0 w-full max-w-[500px] flex-1 flex-col gap-4 px-4 py-4 sm:py-6 md:px-0">
    <.activity_log
      log={@streams.log}
      has_events?={@log_window != nil}
      loader={@events_loader}
      more_events?={@more_events?}
      time_zone={@time_zone}
      current_user_id={@current_user.id}
    />
    <.status_card working={@working?} form={@quick_form} />
  </main>
</div>

<.modal :if={@session_modal} id="session-modal" show on_cancel={JS.push("close-session-modal")}>
  <h2 id="session-modal-title" class="text-2xl font-bold text-gray-900">
    {if @session_modal.mode == :edit, do: "Edit work session", else: "Add past work session"}
  </h2>
  <p id="session-modal-description" class="mb-6 mt-1 text-sm text-gray-500">
    <%= cond do %>
      <% @session_modal.running? -> %>
        This session is still running. You can change when it started.
      <% @session_modal.mode == :edit -> %>
        Change the times or location. Times are in your local timezone.
      <% true -> %>
        Record a work session you forgot to log. Times are in your local timezone.
    <% end %>
  </p>
  <.session_form
    form={@session_form}
    today={local_date(DateTime.utc_now(), @time_zone)}
    running?={@session_modal.running?}
    editing?={@session_modal.mode == :edit}
  />
</.modal>
