<.auth_card
  title="Employin"
  subtitle={
    if @step == :enter_email,
      do: "Sign in to your account",
      else: "Enter the code we sent to #{@email}"
  }
>
  <%!-- Both steps stay in the DOM and slide horizontally. --%>
  <div class={[
    "relative overflow-hidden transition-all duration-100",
    @step == :enter_email && "min-h-[180px]",
    @step == :enter_otp && "min-h-[260px]"
  ]}>
    <div class={[
      "absolute w-full px-2 transition-all duration-500",
      @step == :enter_email && "pointer-events-auto translate-x-0 opacity-100",
      @step != :enter_email && "pointer-events-none -translate-x-full opacity-0"
    ]}>
      <.form id="email-form" for={@form} phx-submit="send-otp" phx-change="validate">
        <.input
          type="email"
          field={@form[:email]}
          label="Email address"
          phx-debounce="750"
          placeholder="Enter your email"
          autocomplete="email"
          required
        />

        <div class="mt-6">
          <.submit_button loading_label="Sending code...">Send verification code</.submit_button>
        </div>
      </.form>
    </div>

    <div class={[
      "absolute w-full px-2 transition-all duration-500",
      @step == :enter_otp && "pointer-events-auto translate-x-0 opacity-100",
      @step != :enter_otp && "pointer-events-none translate-x-full opacity-0"
    ]}>
      <.form
        id="otp-form"
        for={@otp_form}
        action={~p"/login/verify"}
        method="post"
        phx-submit="submit-otp"
        phx-trigger-action={@trigger_submit}
      >
        <input type="hidden" name="token" value={@token} />
        <.input
          type="text"
          field={@otp_form[:otp]}
          label="Verification code"
          placeholder="Enter verification code"
          inputmode="numeric"
          autocomplete="one-time-code"
          maxlength="6"
          required
        />

        <div class="mt-2 text-sm">
          <span
            :if={@show_countdown}
            id="otp-countdown"
            phx-hook="OtpCountdown"
            phx-update="ignore"
            data-seconds={@countdown_seconds}
            class="text-gray-700"
          >
            Resend OTP in {Calendar.strftime(Time.add(~T[00:00:00], @countdown_seconds), "%M:%S")}
          </span>
          <button
            :if={!@show_countdown}
            id="resend-button"
            type="button"
            phx-click="resend-otp"
            phx-disable-with="Resending..."
            class="font-medium text-indigo-600 hover:text-indigo-500"
          >
            Resend OTP
          </button>
        </div>

        <div class="mt-6">
          <.submit_button loading_label="Verifying...">Verify and sign in</.submit_button>
        </div>
      </.form>

      <div class="mt-6 text-center sm:mt-4">
        <button
          type="button"
          phx-click="back-to-email"
          class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-500"
        >
          <.icon name="hero-arrow-left" class="h-4 w-4" /> Back to email
        </button>
      </div>
    </div>
  </div>
</.auth_card>
